FROM mcr.microsoft.com/playwright:v1.52.0

LABEL maintainer="info@fjox.win"
WORKDIR /app
# install vidsrc-scrapper
RUN apt update && apt install -y git curl && git clone https://github.com/fjox/vidsrc-scraper /app && cd /app && npm install


# Run the app by default when the container starts
EXPOSE 3000
CMD ["npm","start"]
